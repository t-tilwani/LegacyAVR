<Application x:Class="LegacyAVR.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LegacyAVR.UI.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
            <conv:InverseBoolConverter x:Key="Not" />
            <conv:DbTextConverter x:Key="DbText" />
            <conv:PercentConverter x:Key="Percent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
